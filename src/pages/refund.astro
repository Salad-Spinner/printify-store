<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Refund Form | WAM Studios Store</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600&display=swap');

      :root {
        --primary: #00ff9f;
        --dark: #0a0a0a;
        --accent-cyan: #22d3ee;
        --accent-orange: #f97316;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Inter', sans-serif;
        color: white;
        background: var(--dark);
        overflow-x: hidden;
        scroll-behavior: smooth;
        min-height: 100vh;
      }

      body.animate-in {
        animation: fade 2s ease-in;
      }

      header.header-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        width: 100%;
        background: rgba(10, 10, 10, 0.96);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }

      .header-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 40px;
      }

      .header-nav h1 {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.75rem, 2.5vw, 2.4rem);
        letter-spacing: -0.5px;
        color: white;
      }

      .main-content {
        padding: 40px;
        max-width: 1280px;
        margin: 0 auto;
      }

      @keyframes fade {
        0% { opacity: 0; filter: blur(50px); }
        50% { opacity: 0.5; filter: blur(0px); }
        100% { opacity: 1; filter: blur(0px); }
      }
      @keyframes inventivation {
        0% { border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 25px; }
        25% { border: 1px solid rgb(255, 0, 0); border-radius: 25px; }
        50% { border: 1px solid rgb(0, 183, 255); border-radius: 25px; }
        75% { border: 1px solid rgb(0, 255, 149); border-radius: 25px; }
        100% { border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 25px; }
      }

      .card:hover {
        animation: inventivation 3s infinite alternate;
      }

      /* m / Hero styles (inlined from design) */
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600&display=swap');

      :root {
        --primary: #00ff9f;
        --dark: #0a0a0a;
        --accent-cyan: #22d3ee;
        --accent-orange: #f97316;
      }

      * { margin:0; padding:0; box-sizing: border-box; }

      body { font-family: 'Inter', sans-serif; color: white; background: var(--dark); overflow-x: hidden; scroll-behavior: smooth; }

      .section { min-height: 100vh; position: relative; display:flex; align-items:center; justify-content:center; scroll-snap-align: start; }

      /* m Section */
      #m { background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%); text-align:center; padding: 6rem 20px; }

      .hero-content { max-width: 800px; z-index:2; }

      .hero-logo { width: 180px; height: 180px; margin: 0 auto 2rem; display:block; filter: drop-shadow(0 20px 40px rgba(0,255,159,0.25)); }

      #m h1 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(2.4rem, 6vw, 4.2rem); margin-bottom: 1rem; background: linear-gradient(90deg,#fff,var(--primary)); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

      .subtitle { font-size: 1.15rem; opacity: 0.85; margin-bottom: 2rem; color: #d1d5db; }

      .btn.hero-cta { display:inline-block; padding: 12px 28px; background: var(--primary); color:#070707; border-radius:9999px; font-weight:700; text-decoration:none; }
      
      .back-link {
        display: inline-block;
        margin-bottom: 20px;
        color: #cbd5e1;
        text-decoration: none;
        font-size: 0.9rem;
      }

      .back-link:hover {
        color: white;
      }
      
      .snipcart-checkout {
        background: var(--primary);
        color: #0a0a0a;
        border: none;
        padding: 10px 20px;
        border-radius: 20px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        transition: transform 0.2s ease, background 0.2s ease;
      }

      .snipcart-checkout:hover {
        transform: translateY(-1px);
        background: #00eca8;
      }
      
      .snipcart-items-count {
        background: #111;
        color: var(--primary);
        border-radius: 9999px;
        padding: 2px 8px;
        font-size: 0.8rem;
        font-weight: 800;
      }
    </style>
  </head>
  <body>

    <!-- Unified Header Navigation Panel -->
    <header class="header-nav">
      <a href="/printify-store/"><img src="/wamlogowhite.png" alt="WAM Studios Shop" class="site-logo" width="20%"/></a>
      <button class="snipcart-checkout">
        🛒 Cart <span class="snipcart-items-count">0</span>
      </button>
    </header>
<iframe src="https://app.youform.com/forms/1dft47si" width="100%" height="100vh" style="border:none; min-height:calc(100vh - 96px);"></iframe>
<iframe id="footer-frame" src="footer/footer" title="Portfolio Footer" scrolling="no" style="background-color: white;" width="100%" height="300px"></iframe>
  </body>
</html>