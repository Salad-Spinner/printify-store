---
const headerLogo = '/wamlogowhite.png';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WAM Merch Refund Request Form</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');

      :root {
        --bg: #09090b;
        --panel: rgba(255,255,255,0.05);
        --panel-soft: rgba(255,255,255,0.03);
        --border: rgba(255,255,255,0.12);
        --text: #f5f5f5;
        --muted: #cbd5e1;
        --primary: #00ff9f;
        --primary-strong: #00d88a;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
      }

      body { min-height: 100vh; }

      a { color: inherit; }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(9,9,11,0.95);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }

      .nav {
        max-width: 1100px;
        margin: 0 auto;
        padding: 18px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
      }

      .logo {
        width: 48px;
        height: auto;
      }

      .brand-name {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: -0.04em;
      }

      .nav-link {
        text-decoration: none;
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 10px 16px;
        background: rgba(255,255,255,0.02);
      }

      .page {
        max-width: 980px;
        margin: 0 auto;
        padding: 48px 24px 72px;
      }

      .card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);
        padding: 28px;
      }

      .eyebrow {
        display: inline-block;
        padding: 8px 12px;
        background: rgba(0,255,159,0.08);
        border: 1px solid rgba(0,255,159,0.25);
        color: var(--primary);
        border-radius: 999px;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
      }

      h1 {
        margin: 18px 0 10px;
        font-family: 'Space Grotesk', sans-serif;
        letter-spacing: -0.05em;
        font-size: clamp(2.3rem, 5vw, 3.4rem);
      }

      .intro {
        color: var(--muted);
        line-height: 1.7;
        margin: 0 0 28px;
      }

      form {
        display: grid;
        gap: 18px;
      }

      .field {
        display: grid;
        gap: 8px;
      }

      label {
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 700;
      }

      input, select, textarea, button {
        font: inherit;
      }

      input, select, textarea {
        width: 100%;
        background: var(--panel-soft);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px 14px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: rgba(0,255,159,0.6);
        box-shadow: 0 0 0 3px rgba(0,255,159,0.08);
      }

      textarea {
        min-height: 120px;
        resize: vertical;
      }

      .row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }

      .checkbox-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        color: var(--muted);
        line-height: 1.6;
        font-size: 0.95rem;
      }

      .checkbox-row input {
        width: 18px;
        height: 18px;
        accent-color: var(--primary);
        margin-top: 4px;
      }

      .submit {
        border: none;
        background: linear-gradient(135deg, var(--primary), var(--primary-strong));
        color: #04110c;
        font-weight: 800;
        padding: 15px 22px;
        border-radius: 12px;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 24px 40px rgba(0,255,159,0.16);
      }

      .submit:hover {
        transform: translateY(-1px);
      }

      .small {
        color: var(--muted);
        font-size: 0.83rem;
      }

      @media (max-width: 760px) {
        .row {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="nav">
        <a href={import.meta.env.BASE_URL} class="brand" aria-label="Back to WAM Studios">
          <img src={headerLogo} alt="WAM Studios" class="logo" />
          <span class="brand-name">WAM Studios</span>
        </a>
        <a href={import.meta.env.BASE_URL} class="nav-link">← Return to Shop</a>
      </div>
    </header>

    <main class="page">
      <div class="card">
        <span class="eyebrow">Refund Request</span>
        <h1>WAM Merch Refund Request Form</h1>
        <p class="intro">
          Please complete the form below so we can review your refund request as quickly as possible.
        </p>

        <form id="refund-form" novalidate>
          <div class="field">
            <label for="legal-name">To begin, please enter your legal name.</label>
            <input id="legal-name" name="legalName" type="text" placeholder="Enter your legal name" required />
          </div>

          <div class="field">
            <label for="reason">What is the reason for your refund request today?</label>
            <select id="reason" name="refundReason" required>
              <option value="">Select a reason</option>
              <option>Item did not arrive</option>
              <option>Item arrived damaged</option>
              <option>Wrong item received</option>
              <option>Item does not match description</option>
              <option>Quality issue</option>
              <option>Other</option>
            </select>
          </div>

          <div class="field">
            <label for="order-number">Please provide the order number.</label>
            <input id="order-number" name="orderNumber" type="text" placeholder="e.g. 12345" required />
          </div>

          <div class="field">
            <label for="item-names">What is the name(s) of the item(s) you want a refund for?</label>
            <input id="item-names" name="itemNames" type="text" placeholder="e.g. Dunno" required />
          </div>

          <div class="row">
            <div class="field">
              <label for="phone">Thank you for your information. Please share your phone number to proceed with the refund.</label>
              <input id="phone" name="phone" type="tel" placeholder="+61 412 345 678" required />
            </div>

            <div class="field">
              <label for="email">Please also provide your email address.</label>
              <input id="email" name="email" type="email" placeholder="you@example.com" required />
            </div>
          </div>

          <label class="checkbox-row">
            <input type="checkbox" required />
            <span>I confirm the information above is correct and I understand this request will be reviewed by the WAM team.</span>
          </label>

          <button type="submit" class="submit">Submit Refund Request</button>

          <div class="small">
            We will review your request and contact you by phone or email if additional information is required.
          </div>
        </form>
      </div>
    </main>

    <script>
      const form = document.getElementById('refund-form');

      form?.addEventListener('submit', (event) => {
        event.preventDefault();

        const required = Array.from(form.querySelectorAll('[required]'));
        const invalid = required.some((field) => {
          if (field.type === 'checkbox') return !field.checked;
          return !String(field.value).trim();
        });

        if (invalid) {
          alert('Please complete all required fields before submitting.');
          return;
        }

        const data = new FormData(form);
        const payload = Object.fromEntries(data.entries());
        window.sessionStorage.setItem('refundRequest', JSON.stringify(payload));
        window.location.href = `${import.meta.env.BASE_URL}refund-submitted`;
      });
    </script>
  </body>
</html>
