---
const headerLogo = '/wlw.png';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Refund Request | WAM Studios</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');

      :root {
        --primary: #00ff9f;
        --dark: #0a0a0a;
        --surface: rgba(255,255,255,0.05);
        --surface-strong: rgba(255,255,255,0.08);
        --border: rgba(255,255,255,0.12);
        --text: #ffffff;
        --muted: #cbd5e1;
        --shadow: rgba(0, 0, 0, 0.22);
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100vh;
        background: var(--dark);
        color: var(--text);
        font-family: 'Inter', sans-serif;
      }

      body { overflow-x: hidden; }
      a { color: inherit; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        width: 100%;
        background: rgba(10, 10, 10, 0.96);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }

      .header-nav {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
      }

      .brand-logo {
        width: 52px;
        height: auto;
      }

      .brand-name {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.1rem, 2vw, 1.5rem);
        font-weight: 700;
        letter-spacing: -0.05em;
      }

      .shop-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: var(--text);
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.02);
        border-radius: 9999px;
        padding: 10px 18px;
        font-weight: 600;
      }

      .page {
        max-width: 900px;
        margin: 0 auto;
        padding: 48px 24px 72px;
      }

      .card {
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--border);
        border-radius: 28px;
        padding: 32px 28px;
        box-shadow: 0 24px 60px var(--shadow);
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 16px;
        color: var(--primary);
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.72rem;
      }

      h1 {
        margin: 0 0 18px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2.4rem, 5vw, 4rem);
        line-height: 0.98;
        letter-spacing: -0.06em;
      }

      .intro {
        color: var(--muted);
        margin: 0 0 28px;
        line-height: 1.7;
      }

      .wizard {
        position: relative;
        min-height: 390px;
      }

      .question {
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.45s ease, transform 0.45s ease;
        pointer-events: none;
      }

      .question.active {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }

      .label {
        display: block;
        margin-bottom: 10px;
        color: #f5f5f5;
        font-size: 1.05rem;
        line-height: 1.5;
        font-weight: 600;
      }

      input, select, textarea, button {
        font: inherit;
      }

      input, select, textarea {
        width: 100%;
        max-width: 700px;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(255,255,255,0.03);
        color: var(--text);
        border-radius: 12px;
        padding: 13px 14px;
        font-size: 1rem;
      }

      input::placeholder,
      textarea::placeholder {
        color: rgba(203,213,225,0.72);
      }

      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: rgba(0,255,159,0.5);
        box-shadow: 0 0 0 4px rgba(0,255,159,0.08);
      }

      .controls {
        margin-top: 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .nav-btn {
        border: none;
        border-radius: 12px;
        padding: 12px 18px;
        font-weight: 800;
        cursor: pointer;
        transition: transform 0.2s ease;
      }

      .nav-btn:hover {
        transform: translateY(-1px);
      }

      .nav-btn.back {
        background: transparent;
        color: var(--text);
        border: 1px solid rgba(255,255,255,0.12);
      }

      .nav-btn.next, .nav-btn.submit {
        background: var(--primary);
        color: #0a0a0a;
      }

      .hidden { display: none !important; }

      @media (max-width: 640px) {
        .header-nav { padding-left: 20px; padding-right: 20px; }
        .controls { justify-content: stretch; }
        .nav-btn { width: 100%; }
      }
    </style>
  </head>
  <body>
    <header class=\"site-header\">
      <div class=\"header-nav\">
        <a href={import.meta.env.BASE_URL} class=\"brand\" aria-label=\"Back to WAM Studios\">
          <img src={headerLogo} alt=\"WAM Studios\" class=\"brand-logo\" />
          <span class=\"brand-name\">WAM Studios</span>
        </a>

        <a href={import.meta.env.BASE_URL} class=\"shop-link\">← Return to Shop</a>
      </div>
    </header>

    <main class=\"page\">
      <div class=\"card\">
        <div class=\"eyebrow\">Refund Request</div>
        <h1>WAM Merch Refund Request Form</h1>
        <p class=\"intro\">
          Please complete the form below so we can review your refund request as quickly as possible.
        </p>

        <form id=\"refund-form\">
          <div class=\"wizard\">
            <div class=\"question active\" data-index=\"0\">
              <label class=\"label\" for=\"legalName\">To begin, please enter your legal name.</label>
              <input id=\"legalName\" name=\"legalName\" type=\"text\" placeholder=\"Enter your legal name\" required />
            </div>

            <div class=\"question\" data-index=\"1\">
              <label class=\"label\" for=\"refundReason\">What is the reason for your refund request today?</label>
              <select id=\"refundReason\" name=\"refundReason\" required>
                <option value=\"\">Select a reason</option>
                <option>Item did not arrive</option>
                <option>Item arrived damaged</option>
                <option>Wrong item received</option>
                <option>Item does not match description</option>
                <option>Quality issue</option>
                <option>Other</option>
              </select>
            </div>

            <div class=\"question\" data-index=\"2\">
              <label class=\"label\" for=\"orderNumber\">Please provide the order number.</label>
              <input id=\"orderNumber\" name=\"orderNumber\" type=\"text\" placeholder=\"e.g. 12345\" required />
            </div>

            <div class=\"question\" data-index=\"3\">
              <label class=\"label\" for=\"itemNames\">What is the name(s) of the item(s) you want a refund for?</label>
              <input id=\"itemNames\" name=\"itemNames\" type=\"text\" placeholder=\"e.g. Dunno\" required />
            </div>

            <div class=\"question\" data-index=\"4\">
              <label class=\"label\" for=\"phone\">Thank you for your information. Please share your phone number to proceed with the refund.</label>
              <input id=\"phone\" name=\"phone\" type=\"tel\" placeholder=\"+61 412 345 678\" required />
            </div>

            <div class=\"question\" data-index=\"5\">
              <label class=\"label\" for=\"email\">Please also provide your email address.</label>
              <input id=\"email\" name=\"email\" type=\"email\" placeholder=\"you@example.com\" required />
            </div>
          </div>

          <div class=\"controls\">
            <button type=\"button\" id=\"backBtn\" class=\"nav-btn back hidden\">Back</button>
            <button type=\"button\" id=\"nextBtn\" class=\"nav-btn next\">Next</button>
            <button type=\"submit\" id=\"submitBtn\" class=\"nav-btn submit hidden\">Submit Refund Request</button>
          </div>
        </form>
      </div>
    </main>

    <script>
      const questions = Array.from(document.querySelectorAll('.question'));
      const backBtn = document.getElementById('backBtn');
      const nextBtn = document.getElementById('nextBtn');
      const submitBtn = document.getElementById('submitBtn');
      const form = document.getElementById('refund-form');

      let currentIndex = 0;

      function updateQuestion() {
        questions.forEach((q, i) => q.classList.toggle('active', i === currentIndex));
        const current = questions[currentIndex];
        const currentInput = current.querySelector('input, select');

        if (currentInput) {
          setTimeout(() => currentInput.focus(), 120);
        }

        backBtn.classList.toggle('hidden', currentIndex === 0);
        nextBtn.classList.toggle('hidden', currentIndex === questions.length - 1);
        submitBtn.classList.toggle('hidden', currentIndex !== questions.length - 1);
      }

      function validateCurrentQuestion() {
        const current = questions[currentIndex];
        const field = current.querySelector('input, select');
        if (!field) return true;
        if (field.type === 'checkbox') return field.checked;
        return field.value.trim() !== '';
      }

      backBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex -= 1;
          updateQuestion();
        }
      });

      nextBtn.addEventListener('click', () => {
        if (!validateCurrentQuestion()) {
          const field = questions[currentIndex].querySelector('input, select');
          if (field) field.focus();
          alert('Please complete this field before continuing.');
          return;
        }

        if (currentIndex < questions.length - 1) {
          currentIndex += 1;
          updateQuestion();
        }
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!validateCurrentQuestion()) {
          alert('Please complete the final field before submitting.');
          return;
        }

        const payload = Object.fromEntries(new FormData(form).entries());

        const response = await fetch('/api/refund', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          alert('There was a problem sending your refund request. Please try again.');
          return;
        }

        window.location.href = `${import.meta.env.BASE_URL}refund-submitted`;
      });

      updateQuestion();
    </script>
  </body>
</html>
