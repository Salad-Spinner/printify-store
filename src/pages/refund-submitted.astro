---
const basePath = import.meta.env.BASE_URL || '/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Refund Request Submitted</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');

      :root {
        --bg: #09090b;
        --panel: rgba(255,255,255,0.05);
        --border: rgba(255,255,255,0.12);
        --text: #f5f5f5;
        --muted: #cbd5e1;
        --primary: #00ff9f;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100vh;
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
      }

      body {
        display: grid;
        place-items: center;
        padding: 24px;
      }

      .card {
        width: min(720px, 100%);
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 40px 30px;
        box-shadow: 0 24px 60px rgba(0,0,0,0.18);
        text-align: center;
      }

      .badge {
        display: inline-block;
        background: rgba(0,255,159,0.12);
        border: 1px solid rgba(0,255,159,0.3);
        color: var(--primary);
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
      }

      h1 {
        margin: 18px 0 14px;
        font-family: 'Space Grotesk', sans-serif;
        letter-spacing: -0.05em;
        font-size: clamp(2.1rem, 5vw, 3rem);
      }

      p {
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.7;
      }

      .actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        padding: 14px 18px;
        text-decoration: none;
        font-weight: 800;
        transition: transform 0.2s ease;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--primary), #00d88a);
        color: #04110c;
      }

      .btn-secondary {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text);
      }

      .btn:hover {
        transform: translateY(-1px);
      }
    </style>
  </head>
  <body>
    <div class="card">
      <span class="badge">Success</span>
      <h1>Your refund request has been submitted.</h1>
      <p>
        Thanks for contacting WAM Studios. We’ve received your refund request and will review it shortly.
        If we need any additional details, we’ll reach out by email or phone.
      </p>

      <div class="actions">
        <a href={basePath} class="btn btn-primary">Return to Shop</a>
        <a href={`${basePath}refund`} class="btn btn-secondary">Submit Another Request</a>
      </div>
    </div>
  </body>
</html>
